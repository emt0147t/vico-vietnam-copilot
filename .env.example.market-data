# ============================================================================
# MARKET DATA INTEGRATION - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your API keys

# ============================================================================
# 🌍 OFFICIAL MARKET DATA SOURCES (FREE)
# ============================================================================

# World Bank Open Data
# Website: https://data.worldbank.org/
# No API key needed - but provide credential to avoid rate limiting
WORLD_BANK_ENABLED=true

# UN COMTRADE (International Trade Statistics)
# Website: https://comtradeplus.un.org/
UN_COMTRADE_ENABLED=true

# OECD Statistics Database
# Website: https://data.oecd.org/
OECD_ENABLED=true

# ============================================================================
# 🏪 INDUSTRY REPORTS (OPTIONAL - PAID)
# ============================================================================

# IBISWorld - Industry Analysis Reports
# Website: https://www.ibisworld.com/api/
# Cost: Paid subscription
IBISWORLD_API_KEY=

# Statista - Market Research Platform
# Website: https://developer.statista.com/
# Cost: Paid subscription (~$500-2000/month)
STATISTA_API_KEY=
STATISTA_TOKEN=

# S&P Capital IQ - Financial Data
# Website: https://www.capitaliq.com/
# Cost: Paid subscription (Enterprise)
SP_CAPITAL_IQ_KEY=

# ============================================================================
# 📊 COUNTRY-SPECIFIC STATISTICS
# ============================================================================

# Vietnam - General Statistics Office (GSO)
# Website: https://www.gso.gov.vn/
# Download data manually, no API
GSO_VIETNAM_ENABLED=true

# Thailand - Board of Investment (BOI)
# Website: https://www.boi.go.th/
BOI_THAILAND_ENABLED=true

# Singapore - Department of Statistics
# Website: https://www.singstat.gov.sg/
SINGAPORE_STATS_ENABLED=true

# Indonesia - Statistics Indonesia (BPS)
# Website: https://www.bps.go.id/
BPS_INDONESIA_ENABLED=true

# ============================================================================
# 📰 NEWS & TRENDS (FOR MARKET MONITORING)
# ============================================================================

# NewsAPI - Breaking news and market trends
# Website: https://newsapi.org/
# Free tier: 100 requests/day
NEWSAPI_KEY=

# GNews - Global news API
# Website: https://gnews.io/
# Free tier: 100 requests/day
GNEWS_KEY=

# ============================================================================
# 💼 COMPANY FINANCIAL DATA
# ============================================================================

# Alpha Vantage - Stock and financial data
# Website: https://www.alphavantage.co/
# Free tier: 500 requests/day
ALPHA_VANTAGE_KEY=

# SEC Edgar - US company filings
# No API key needed - direct access
SEC_EDGAR_ENABLED=true

# ============================================================================
# 🔧 TECHNICAL SETTINGS
# ============================================================================

# Enable real data fetching (disable to use generated data)
USE_REAL_MARKET_DATA=true

# Cache TTL (in milliseconds) - How long to cache market data
MARKET_DATA_CACHE_TTL=86400000  # 24 hours

# API request timeout
MARKET_API_TIMEOUT=10000  # 10 seconds

# Log API calls for debugging
DEBUG_MARKET_API_CALLS=false

# ============================================================================
# DATABASE
# ============================================================================

# MongoDB for caching real data
MONGODB_URI=mongodb://localhost:27017/vico

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. GETTING STARTED (FREE):
#    - All "ENABLED=true" sources are free to use
#    - Just set them to true to enable
#    - No API keys needed for World Bank, UN, OECD, GSO, etc.
#
# 2. API KEYS (FREE TIER):
#    - Sign up at:
#      * NewsAPI: https://newsapi.org/register
#      * GNews: https://gnews.io/
#      * Alpha Vantage: https://www.alphavantage.co/api/
#    - Each provides free tier with limited requests/day
#
# 3. PREMIUM SOURCES (PAID):
#    - IBISWorld: Enterprise pricing
#    - Statista: ~$500-2000/month
#    - S&P Capital IQ: Enterprise pricing
#    - Add keys only if you have subscriptions
#
# 4. RECOMMENDED SETUP:
#    Phase 1 (Week 1): Set all ENABLED=true for free sources
#    Phase 2 (Week 2): Get API keys for NewsAPI, GNews, Alpha Vantage
#    Phase 3 (Future): Add premium sources as budget allows
#
# ============================================================================
