# ============================================
# VICO - Environment Variables (Railway Deploy)
# Copy file này và điền giá trị thật vào Railway Dashboard
# ============================================

# [BẮT BUỘC] Google Gemini AI API Key
GEMINI_API_KEY=

# [BẮT BUỘC] PostgreSQL Database (Supabase)
DATABASE_URL=

# [TÙY CHỌN] MongoDB cho News Database
MONGODB_URI=

# [TỰ ĐỘNG] Railway sẽ set PORT tự động
PORT=3001

# [KHUYÊN DÙNG] Bỏ qua vector seeding lúc khởi động (nhanh hơn)
SKIP_VECTOR_SEEDING=true

# [TÙY CHỌN] Custom Domain (không có https://)
# Ví dụ: vico.vn hoặc app.vico.vn
CUSTOM_DOMAIN=
VITE_APP_URL=

# [TÙY CHỌN] Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# [TỰ ĐỘNG]
NODE_ENV=production
