# ============================================================================
# REAL DATA INTEGRATION - Environment Variables
# ============================================================================
# Copy này thành .env.local và fill in your API keys

# ============================================================================
# 📰 NEWS SOURCES
# ============================================================================
# NewsAPI - https://newsapi.org
# Free tier: 100 requests/day
NEWSAPI_KEY=

# GNews - https://gnews.io
# Free tier: 100 requests/day
GNEWS_KEY=

# Mediastack - https://mediastack.com
# Free tier: Yes, multi-language
MEDIASTACK_KEY=

# ============================================================================
# 💰 FUNDING & COMPANY DATA
# ============================================================================
# Crunchbase API - https://www.crunchbase.com/
# Paid: Starting $999/month
CRUNCHBASE_API_KEY=

# PitchBook - https://pitchbook.com/
# Paid: Enterprise pricing
PITCHBOOK_KEY=

# ============================================================================
# 👥 EMPLOYEE & PEOPLE DATA
# ============================================================================
# Apollo.io - https://www.apollo.io/
# Freemium: Starting free, then $49/month
APOLLO_IO_KEY=

# RocketReach - https://app.rocketreach.co/
# Freemium: Starting free, then $49/month
ROCKETREACH_KEY=

# ============================================================================
# 🛠️ TECH STACK
# ============================================================================
# BuiltWith - https://builtwith.com/api
# Free: 10/day, Paid: $99/month
BUILTWITH_API_KEY=

# Wappalyzer - https://www.wappalyzer.com/api/
# Paid: Contact for pricing
WAPPALYZER_KEY=

# ============================================================================
# 📊 FINANCIAL DATA
# ============================================================================
# Alpha Vantage - https://www.alphavantage.co/
# Free: 500 requests/day
ALPHA_VANTAGE_KEY=

# IEX Cloud - https://iexcloud.io/
# Freemium: Free tier available
IEX_CLOUD_KEY=

# ============================================================================
# 📈 MARKET & INDUSTRY
# ============================================================================
# Statista - https://www.statista.com/
# Paid: Contact for API access
STATISTA_KEY=

# Trading Economics - https://tradingeconomics.com/api/
# Paid: Contact for pricing
TRADING_ECONOMICS_KEY=

# ============================================================================
# ⭐ CUSTOMER REVIEWS
# ============================================================================
# G2 API - Limited access
# https://developer.g2.com/
G2_API_KEY=

# Capterra - Limited access
CAPTERRA_API_KEY=

# Trustpilot - https://developers.trustpilot.com/
TRUSTPILOT_KEY=

# ============================================================================
# 🌐 SOCIAL & WEB SIGNALS
# ============================================================================
# Twitter API v2 - https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# Reddit API - https://www.reddit.com/r/requestAbot
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# SimilarWeb - https://www.similarweb.com/api/
SIMILARWEB_KEY=

# ============================================================================
# 🗄️ DATABASE
# ============================================================================
# MongoDB for caching real data
MONGODB_URI=mongodb://localhost:27017/vico

# ============================================================================
# ⚙️ CONFIGURATION
# ============================================================================
# Prioritize real data over generated
USE_REAL_DATA_FIRST=true

# Show data source attribution
SHOW_DATA_SOURCES=true

# Cache TTL settings (milliseconds)
CACHE_TTL_FINANCIAL=2592000000    # 30 days
CACHE_TTL_TRENDS=86400000         # 1 day
CACHE_TTL_NEWS=86400000           # 1 day
CACHE_TTL_TECHSTACK=2592000000    # 30 days

# Max retries for API calls
API_MAX_RETRIES=3

# API timeout (milliseconds)
API_TIMEOUT=10000

# ============================================================================
# Notes:
# ============================================================================
# 1. FREE APIs to start with:
#    - NewsAPI
#    - GNews  
#    - Alpha Vantage
#    - SEC Edgar (no key needed)
#
# 2. Sign up takes 5-10 minutes per service
#
# 3. Test keys with curl commands from API_SETUP_GUIDE.md
#
# 4. Add additional keys as budget allows
#
# ============================================================================
